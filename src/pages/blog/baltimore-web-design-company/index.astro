.art-side-discovery { display: inline-flex; align-items: center; justify-content: center; gap: 6px; width: 100%; padding: 9px 14px; background: var(--amber); color: var(--ink); border-radius: var(--radius-md); text-decoration: none; font-family: var(--f-body); font-size: 12px; font-weight: 600; transition: background 0.2s ease; }
.art-side-discovery:hover { background: var(--amber-deep); }
.art-side-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 3px; }
.art-side-link { display: flex; flex-direction: column; gap: 2px; padding: 9px 11px; background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius-md); text-decoration: none; color: inherit; transition: all 0.2s ease; }
.art-side-link:hover { border-color: var(--amber); transform: translateX(2px); }
.art-side-link-title { font-family: var(--f-display); font-size: 12.5px; line-height: 1.3; color: var(--ink); font-weight: 500; }
.art-side-link-meta { font-family: var(--f-mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }

/* ── MAIN ─────────────────────────────────────────── */
.art-main { display: flex; flex-direction: column; gap: 0; min-width: 0; }

/* Featured image */
.art-featured-img { margin: 0 0 1.6em; border-radius: var(--radius-lg); overflow: hidden; }
.art-featured-img img { display: block; width: 100%; height: auto; max-height: 480px; object-fit: cover; }

/* AEO snippet / key takeaways */
.art-snippet { background: var(--paper); border: 1.5px solid var(--line); border-radius: var(--radius-lg); padding: 18px 22px; margin-bottom: 1.4em; position: relative; overflow: hidden; }
.art-snippet::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--amber); }
.art-snippet-label { display: block; font-family: var(--f-mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--amber-deep); font-weight: 700; margin-bottom: 10px; }
.art-snippet-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
.art-snippet-list li { font-size: 14px; line-height: 1.6; color: var(--ink-soft); padding-left: 16px; position: relative; }
.art-snippet-list li::before { content: ""; position: absolute; left: 0; top: 8px; width: 5px; height: 5px; border-radius: 50%; background: var(--amber); }

/* H2 headings */
.art-h2 { font-family: var(--f-display); font-size: clamp(20px,2.4vw,28px); font-weight: 500; letter-spacing: -0.022em; color: var(--ink); line-height: 1.22; margin: 2em 0 0.6em; scroll-margin-top: 80px; }
.art-h2:first-child { margin-top: 0; }

/* Prose */
.art-main p { font-size: 15.5px; line-height: 1.76; color: var(--ink-soft); margin: 0 0 1em; }
.art-main ul, .art-main ol { font-size: 15.5px; line-height: 1.76; color: var(--ink-soft); margin: 0 0 1.2em; padding-left: 24px; display: flex; flex-direction: column; gap: 8px; }
.art-main li { padding-left: 4px; }
.art-main li strong { color: var(--ink); }
.art-main a:not(.art-inline-cta-btn) { color: var(--amber-deep); text-decoration: underline; text-underline-offset: 3px; }
.art-main a:not(.art-inline-cta-btn):hover { color: var(--ink); }
.art-main code { font-family: var(--f-mono); font-size: 13px; background: var(--cream); padding: 2px 6px; border-radius: 4px; color: var(--ink); border: 1px solid var(--line); }

/* Comparison table */
.art-compare-wrap { overflow-x: auto; border-radius: var(--radius-lg); border: 1.5px solid var(--line); margin: 1em 0 1.4em; }
.art-compare-table { width: 100%; border-collapse: collapse; font-size: 13.5px; min-width: 560px; }
.art-compare-table thead tr { background: var(--ink); }
.art-compare-table th { padding: 12px 14px; text-align: left; font-family: var(--f-mono); font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: rgba(244,239,230,0.8); }
.art-compare-table td { padding: 11px 14px; border-bottom: 1px solid var(--line); color: var(--ink-soft); font-size: 13.5px; }
.art-compare-table tr:last-child td { border-bottom: none; }
.art-compare-table tr:hover td { background: var(--cream); }
.art-compare-table td:first-child { font-weight: 600; color: var(--ink); font-size: 13px; }
.art-ct-yes { color: #2e6e2e; font-weight: 500; }
.art-ct-no { color: #8b2020; }
.art-ct-partial { color: #7a6020; }

/* FAQ accordion */
.art-faq { display: flex; flex-direction: column; gap: 8px; margin: 1em 0 2em; }
.art-faq-item { border: 1.5px solid var(--line); border-radius: var(--radius-md); overflow: hidden; transition: border-color 0.2s ease; }
.art-faq-item[open] { border-color: var(--amber); }
.art-faq-q { font-size: 15px; font-weight: 600; color: var(--ink); padding: 16px 18px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px; line-height: 1.4; }
.art-faq-q::-webkit-details-marker { display: none; }
.art-faq-q::after { content: "+"; font-family: var(--f-mono); font-size: 18px; color: var(--amber-deep); line-height: 1; flex-shrink: 0; }
.art-faq-item[open] .art-faq-q::after { content: "−"; }
.art-faq-a { font-size: 14.5px; line-height: 1.72; color: var(--ink-soft); padding: 0 18px 16px; margin: 0; border-top: 1px solid var(--line); }

/* Inline CTA */
.art-inline-cta { background: var(--ink); border-radius: var(--radius-lg); padding: 28px 26px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 2.4em; }
.art-inline-cta-text { flex: 1; min-width: 240px; }
.art-inline-cta-h3 { font-family: var(--f-display); font-size: 22px; font-weight: 500; color: var(--cream); margin: 0 0 8px; letter-spacing: -0.02em; }
.art-inline-cta-sub { font-size: 14px; line-height: 1.6; color: rgba(244,239,230,0.55); margin: 0; }
.art-inline-cta-btn { padding: 13px 22px; background: var(--amber); color: var(--ink); border-radius: var(--radius-md); font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; transition: background 0.2s ease; }
.art-inline-cta-btn:hover { background: var(--amber-deep); }

/* ── RESPONSIVE ───────────────────────────────────── */
@media (max-width: 900px) {
  .art-body-grid { grid-template-columns: 1fr; }
  .art-sidebar { position: static; order: 2; }
}
@media (max-width: 600px) {
  .art-h1 { font-size: 26px; }
  .art-inline-cta { flex-direction: column; }
  .art-compare-wrap { font-size: 12px; }
}
</style>

<script>
// TOC active state on scroll
(function() {
  const links = document.querySelectorAll('[data-toc-link]');
  if (!links.length) return;
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      const link = document.querySelector(`[data-toc-link="${e.target.id}"]`);
      if (link) link.classList.toggle('art-toc-link-active', e.isIntersecting);
    });
  }, { rootMargin: '-20% 0px -70% 0px' });
  document.querySelectorAll('[id]').forEach(el => {
    if (document.querySelector(`[data-toc-link="${el.id}"]`)) obs.observe(el);
  });
})();

// Sidebar search
(function() {
  const input = document.getElementById('art-side-search-input');
  const results = document.getElementById('art-side-search-results');
  if (!input || !results) return;
  const index = JSON.parse(document.getElementById('art-search-index')?.textContent || '[]');
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    if (!q) { results.setAttribute('data-empty', ''); results.innerHTML = '<li class="art-side-search-empty">Start typing to search articles</li>'; return; }
    results.removeAttribute('data-empty');
    const hits = index.filter((a: any) => a.title.toLowerCase().includes(q)).slice(0, 6);
    if (!hits.length) { results.innerHTML = '<li class="art-side-search-empty">No results found</li>'; return; }
    results.innerHTML = hits.map((a: any) => `<li><a href="${a.url}" class="art-side-search-result"><span class="art-side-search-title">${a.title}</span><span class="art-side-search-cat">${a.category}</span></a></li>`).join('');
  });
})();
</script>

<script id="art-search-index" type="application/json" set:text={JSON.stringify(
  articles.filter(a => a.status === 'published').map(a => ({
    slug: a.slug,
    url: a.route ?? `/blog/${a.slug}/`,
    title: a.title,
    category: categories[a.category].label
  }))
)} />
