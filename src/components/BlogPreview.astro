---
import { articles, categories, articleUrl } from '../data/blog-articles';

// Show up to 3 published articles; fall back to newest coming-soon if fewer than 3 published
const published = articles.filter((a) => a.status === 'published');
const preview = published.slice(0, 3);

// Per-category gradient + icon for cards without a real image
const catMeta: Record<string, { gradient: string; icon: string }> = {
  'local-seo': {
    gradient: 'linear-gradient(145deg, #0F1A28 0%, #0F1419 60%, #1A2535 100%)',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="3"/><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/></svg>`,
  },
  'buying-guides': {
    gradient: 'linear-gradient(145deg, #2C1A0A 0%, #1A120A 60%, #200F0F 100%)',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>`,
  },
  'industry-seo': {
    gradient: 'linear-gradient(145deg, #0F1A10 0%, #0F1419 60%, #1A2020 100%)',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  },
  'industry-design': {
    gradient: 'linear-gradient(145deg, #1A0F2C 0%, #140F1A 60%, #200F28 100%)',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
  },
  'technical': {
    gradient: 'linear-gradient(145deg, #0F1828 0%, #0F1419 60%, #0F1820 100%)',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  },
  'vertical-deep-dive': {
    gradient: 'linear-gradient(145deg, #200F0F 0%, #1A0F0F 60%, #2C1010 100%)',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
  },
};
---
<section class="blog-section section-pad" id="blog">
  <div class="container">

    <div class="blog-intro">
      <p class="eyebrow blog-eyebrow">From the blog</p>
      <h2 class="h2-section">WordPress web design resources for Maryland business owners</h2>
      <p class="lead">Practical articles about WordPress performance, local SEO, and what actually moves the needle for Maryland service businesses.</p>
    </div>

    <div class="blog-grid">
      {preview.map((article, i) => {
        const meta = catMeta[article.category] ?? catMeta['technical'];
        const cat = categories[article.category];
        const num = String(i + 1).padStart(2, '0');
        return (
          <article class="blog-card">
            <a href={articleUrl(article)} class="blog-card-link" aria-label={`Read: ${article.title}`}>

              <!-- Image area -->
              {article.image ? (
                <div class="blog-img blog-img-photo">
                  <img src={article.image} alt={article.imageAlt ?? article.title} width="800" height="450" loading="lazy" decoding="async" />
                  <div class="blog-img-overlay"></div>
                  <div class="blog-img-bottom">
                    <span class="blog-img-tag mono-xs">{cat.label}</span>
                    <span class="blog-img-num mono-xs">{num}</span>
                  </div>
                </div>
              ) : (
                <div class="blog-img" style={`background: ${meta.gradient}`}>
                  <div class="blog-img-noise"></div>
                  <div class="blog-img-icon" aria-hidden="true" set:html={meta.icon} />
                  <div class="blog-img-overlay"></div>
                  <div class="blog-img-bottom">
                    <span class="blog-img-tag mono-xs">{cat.label}</span>
                    <span class="blog-img-num mono-xs">{num}</span>
                  </div>
                </div>
              )}

              <!-- Body -->
              <div class="blog-body">
                <div class="blog-meta">
                  <span class="blog-date mono-xs">{article.estPublishMonth ?? 'Published'}</span>
                  <span class="blog-dot" aria-hidden="true"></span>
                  <span class="blog-read mono-xs">Published</span>
                </div>
                <h3 class="blog-title">{article.title}</h3>
                <p class="blog-desc">{article.description}</p>
                <span class="blog-cta-link">
                  Read article
                  <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                    <path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>

            </a>
          </article>
        );
      })}
    </div>

    <div class="blog-footer">
      <a href="/blog/" class="cta-outline">Browse all articles &rarr;</a>
      <p class="blog-footer-note mono-xs">New articles every 2 weeks · No newsletter required</p>
    </div>

  </div>
</section>

<style>
  .blog-section {
    background: var(--paper);
  }

  /* ── INTRO ── */
  .blog-intro {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 48px;
  }

  .blog-eyebrow {
    justify-content: center;
  }

  /* ── GRID ── */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-bottom: 36px;
    align-items: stretch;
  }

  /* ── CARD ── */
  .blog-card {
    background: var(--paper);
    border: 1.5px solid rgba(15,20,25,0.07);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 10px rgba(15,20,25,0.05);
    transition: box-shadow var(--transition), transform var(--transition), border-color var(--transition);
  }

  .blog-card:hover {
    box-shadow: 0 12px 36px rgba(15,20,25,0.12);
    transform: translateY(-4px);
    border-color: rgba(212,147,46,0.3);
  }

  .blog-card-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  /* ── IMAGE AREA ── */
  .blog-img {
    height: 200px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blog-img-photo {
    display: block;
  }

  .blog-img-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .blog-img-photo img {
    transform: scale(1.04);
  }

  .blog-img-noise {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 14px,
        rgba(244,239,230,0.025) 14px,
        rgba(244,239,230,0.025) 15px
      );
  }

  .blog-img-icon {
    position: relative;
    z-index: 1;
    color: rgba(212,147,46,0.55);
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(212,147,46,0.06);
    border: 1px solid rgba(212,147,46,0.15);
    border-radius: var(--radius-md);
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  .blog-card:hover .blog-img-icon {
    color: rgba(212,147,46,0.85);
    background: rgba(212,147,46,0.1);
    border-color: rgba(212,147,46,0.3);
  }

  .blog-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15,20,25,0.5) 0%, transparent 50%);
    pointer-events: none;
  }

  .blog-img-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 2;
  }

  .blog-img-tag {
    background: rgba(212,147,46,0.9);
    color: var(--ink);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .blog-img-num {
    color: rgba(244,239,230,0.35);
    font-size: 11px;
    letter-spacing: 0.1em;
  }

  /* ── BODY ── */
  .blog-body {
    padding: 24px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    border-top: 1px solid rgba(15,20,25,0.06);
  }

  /* ── META ── */
  .blog-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .blog-date {
    color: var(--amber-deep);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .blog-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--ink-muted);
    opacity: 0.3;
    flex-shrink: 0;
  }

  .blog-read {
    color: var(--ink-muted);
    font-size: 10px;
    letter-spacing: 0.05em;
  }

  /* ── TITLE ── */
  .blog-title {
    font-family: var(--f-display);
    font-size: clamp(16px, 1.6vw, 19px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--ink);
    transition: color var(--transition);
  }

  .blog-card:hover .blog-title {
    color: var(--amber-deep);
  }

  /* ── DESC ── */
  .blog-desc {
    font-size: 13.5px;
    color: var(--ink-muted);
    line-height: 1.6;
    flex: 1;
  }

  /* ── READ LINK ── */
  .blog-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--amber-deep);
    margin-top: 4px;
    transition: gap var(--transition), color var(--transition);
  }

  .blog-card:hover .blog-cta-link {
    gap: 10px;
    color: var(--ink);
  }

  /* ── FOOTER ── */
  .blog-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .blog-footer-note {
    color: var(--ink-muted);
    font-size: 10px;
    letter-spacing: 0.07em;
    opacity: 0.6;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
